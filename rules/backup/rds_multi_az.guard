# rules/backup/rds_multi_az.guard
#
# Category: backup (Availability for override)
# Reports RDS instances without Multi-AZ enabled.

let rds_instances = Resources.*[ Type == 'AWS::RDS::DBInstance' ]

rule rds_multi_az when %rds_instances !empty {
  %rds_instances.Properties.MultiAZ == true
    << This RDS DB instance does not have Multi-AZ enabled. Without a standby in another Availability Zone, an AZ failure causes downtime. Set MultiAZ to true for production workloads. >>
}
