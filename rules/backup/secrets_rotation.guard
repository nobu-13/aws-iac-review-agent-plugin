# rules/backup/secrets_rotation.guard
#
# Category: backup (DataProtection override)
# Reports Secrets Manager secrets without automatic rotation configured.

let secrets = Resources.*[ Type == 'AWS::SecretsManager::Secret' ]
let rotation_schedules = Resources.*[ Type == 'AWS::SecretsManager::RotationSchedule' ]

rule secrets_rotation when %secrets !empty {
  %rotation_schedules !empty
    << This template defines a secret but no rotation schedule. Add an AWS::SecretsManager::RotationSchedule resource to enable automatic credential rotation. >>
}
