#!/bin/sh
# A cfn-guard below the minimum supported version (toolcheck: 3.0.0).
#
# 2.1.0 is a real cfn-guard release. require_known_tool must refuse it with
# ToolVersionError before any rule is evaluated (Requirement 15 AC6), so every
# path other than --version exits non-zero: reaching them would mean the version
# gate let an unsupported tool through, and a silent success would hide that.
#
# POSIX sh so the script still runs with PATH set to this directory alone; see
# ../cfn-guard-crash/cfn-guard. Arguments are compared, never evaluated.
for arg in "$@"; do
    if [ "$arg" = "--version" ]; then
        echo "cfn-guard 2.1.0"
        exit 0
    fi
done
echo "fake cfn-guard 2.1.0: should not have been invoked past the version gate" >&2
exit 255
